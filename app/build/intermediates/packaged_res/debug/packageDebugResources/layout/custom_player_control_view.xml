<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Top Overlay Bar with Title, Back Button, and Analytics Telemetry Chip -->
    <LinearLayout
        android:id="@+id/topBarOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_player_top_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnPlayerBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/details"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/tvPlayerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Cyberpunk: Neon Genesis" />

        <!-- Live Analytics Event Badge / Diagnostic Display -->
        <TextView
            android:id="@+id/tvTelemetryEventBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="EVENT: PLAYER_READY" />

    </LinearLayout>

    <!-- Center Playback Controls -->
    <LinearLayout
        android:id="@+id/centerControlsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Rewind 10s Button -->
        <ImageButton
            android:id="@id/exo_rew"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/play"
            android:src="@drawable/ic_replay_10" />

        <!-- Play / Pause Container (Stacked at exact same position so only one is shown) -->
        <FrameLayout
            android:id="@+id/playPauseContainer"
            android:layout_width="68dp"
            android:layout_height="68dp">

            <!-- Play Button (shown when paused) -->
            <ImageButton
                android:id="@id/exo_play"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pill_button"
                android:contentDescription="@string/play"
                android:src="@drawable/ic_play"
                android:visibility="gone"
                app:tint="#000000" />

            <!-- Pause Button (shown when playing) -->
            <ImageButton
                android:id="@id/exo_pause"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pill_button"
                android:contentDescription="@string/play"
                android:src="@drawable/ic_pause"
                android:visibility="visible"
                app:tint="#000000" />

        </FrameLayout>

        <!-- Fast Forward 10s Button -->
        <ImageButton
            android:id="@id/exo_ffwd"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/play"
            android:src="@drawable/ic_forward_10" />

    </LinearLayout>

    <!-- Bottom Progress and Time bar -->
    <LinearLayout
        android:id="@+id/bottomControlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_player_bottom_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            tools:text="01:24" />

        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_weight="1"
            app:buffered_color="#66FFFFFF"
            app:played_color="@color/primary_accent"
            app:scrubber_color="@color/primary_accent"
            app:unplayed_color="#33FFFFFF" />

        <TextView
            android:id="@id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="12:00" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
