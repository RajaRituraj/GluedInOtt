<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4D000000">

    <!-- Center playback controls -->
    <LinearLayout
        android:id="@+id/centerControlsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Rewind 10s Button -->
        <ImageButton
            android:id="@id/exo_rew"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/play"
            android:src="@drawable/ic_replay_10" />

        <!-- Play Button -->
        <ImageButton
            android:id="@id/exo_play"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_pill_button"
            android:contentDescription="@string/play"
            android:src="@drawable/ic_play"
            app:tint="#000000" />

        <!-- Pause Button -->
        <ImageButton
            android:id="@id/exo_pause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_pill_button"
            android:contentDescription="@string/play"
            android:src="@drawable/ic_pause"
            app:tint="#000000" />

        <!-- Fast Forward 10s Button -->
        <ImageButton
            android:id="@id/exo_ffwd"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/play"
            android:src="@drawable/ic_forward_10" />

    </LinearLayout>

    <!-- Bottom Progress and Time bar -->
    <LinearLayout
        android:id="@+id/bottomControlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#B3000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            tools:text="01:24" />

        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            app:buffered_color="#66FFFFFF"
            app:played_color="@color/primary_accent"
            app:scrubber_color="@color/primary_accent"
            app:unplayed_color="#33FFFFFF" />

        <TextView
            android:id="@id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="12:00" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
