<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".OttApplication"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.GluedInOtt"
        android:hardwareAccelerated="true">

        <!-- Home Screen (Launcher) -->
        <activity
            android:name=".presentation.home.HomeActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Content Detail Screen -->
        <activity
            android:name=".presentation.detail.ContentDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Video Player Screen -->
        <activity
            android:name=".presentation.player.PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:screenOrientation="sensorLandscape" />

    </application>

</manifest>
